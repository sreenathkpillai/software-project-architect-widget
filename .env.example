# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT_ID=your_assistant_id_here

# Dual-model configuration for optimal speed vs quality
OPENAI_QUESTION_MODEL=gpt-4-turbo
OPENAI_DOC_MODEL=gpt-5

# AI Provider Selection
AI_PROVIDER=openai
CLAUDE_MODEL=claude-sonnet-4-20250514

# Prompt optimization (set to false to use full prompt if issues arise)
USE_OPTIMIZED_PROMPT=true

# Answer Ledger optimization (set to false to use full transcript for doc generation)
USE_LEDGER_FOR_DOCGEN=true

SYSTEM_PROMPT="You are Software Project Architect, an expert in software development, system design, and project management..."